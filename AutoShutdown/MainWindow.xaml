<Window x:Class="AutoShutdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1040" Height="720"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.Background>
            <StaticResource ResourceKey="CommandBackgroundBrush"/>
        </Grid.Background>

        <Ellipse x:Name="GlowPurple" Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-120,-130,0,0" Fill="#B779FF" Opacity="0.26" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="78"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="GlowCyan" Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,86,-118,0" Fill="#79D8FF" Opacity="0.22" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="66"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="GlowPink" Width="280" Height="280" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-130,-112" Fill="#FF8ACF" Opacity="0.2" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="78"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="122,142,0,0" Fill="#DDFFFFFF" Opacity="0.5" IsHitTestVisible="False"/>
        <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,164,168,0" Fill="#AAFFFFFF" Opacity="0.55" IsHitTestVisible="False"/>
        <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,210,74" Fill="#BBFF8ACF" Opacity="0.65" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="92"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeroHeader" Grid.Row="0" CornerRadius="24,24,0,0" Padding="26,14"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource CommandCardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="54" Height="54" CornerRadius="20" Background="{StaticResource HeroBrush}"
                            Effect="{StaticResource NeonShadow}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="AutoShutdown v1.4" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Neon Command Center" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" Opacity="0.98"/>
                        <TextBlock Text="状态、动作、触发器都集中在一个更醒目的控制台里。" FontSize="12" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border x:Name="HeaderStatusBadge" Style="{StaticResource StatusBadge}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderStatusText" Text="READY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource StatusReadyBrush}"/>
                        </Border>
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="40" Height="40" FontSize="12"
                                ToolTip="最小化到托盘" Background="{StaticResource GlassSurfaceBrush}" BorderBrush="{StaticResource GlassBorderStrongBrush}" BorderThickness="1"
                                Foreground="{StaticResource TextPrimaryBrush}" Click="Minimize_Click" Padding="0"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="40" Height="40" FontSize="12" Margin="8,0,0,0"
                                ToolTip="隐藏到托盘" Background="#33FF5C8A" BorderBrush="#66FF8ACF" BorderThickness="1"
                                Foreground="#FFE6F1" Click="Close_Click" Padding="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,20,22,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="205"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource GlassPanel}" Padding="14" CornerRadius="26">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="导航" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="8,4,0,12"/>
                            <Border x:Name="NavOverview" Tag="Overview" CornerRadius="16" Padding="14,12" Margin="0,0,0,8"
                                    BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="NavItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavOverviewIndicator" Width="3" CornerRadius="2" Background="{StaticResource NavIndicatorBrush}" Opacity="0"/>
                                    <TextBlock Grid.Column="2" Text="总览" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="NavTimer" Tag="Timer" CornerRadius="16" Padding="14,12" Margin="0,0,0,8"
                                    BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="NavItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavTimerIndicator" Width="3" CornerRadius="2" Background="{StaticResource NavIndicatorBrush}" Opacity="0"/>
                                    <TextBlock Grid.Column="2" Text="定时" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="NavTasks" Tag="Tasks" CornerRadius="16" Padding="14,12" Margin="0,0,0,8"
                                    BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="NavItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavTasksIndicator" Width="3" CornerRadius="2" Background="{StaticResource NavIndicatorBrush}" Opacity="0"/>
                                    <TextBlock Grid.Column="2" Text="任务" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="NavTriggers" Tag="Triggers" CornerRadius="16" Padding="14,12" Margin="0,0,0,8"
                                    BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="NavItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavTriggersIndicator" Width="3" CornerRadius="2" Background="{StaticResource NavIndicatorBrush}" Opacity="0"/>
                                    <TextBlock Grid.Column="2" Text="智能触发" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="NavScript" Tag="Script" CornerRadius="16" Padding="14,12" Margin="0,0,0,8"
                                    BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="NavItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavScriptIndicator" Width="3" CornerRadius="2" Background="{StaticResource NavIndicatorBrush}" Opacity="0"/>
                                    <TextBlock Grid.Column="2" Text="脚本" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                            <Border x:Name="NavSettings" Tag="Settings" CornerRadius="16" Padding="14,12" Margin="0,0,0,8"
                                    BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="NavItem_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="NavSettingsIndicator" Width="3" CornerRadius="2" Background="{StaticResource NavIndicatorBrush}" Opacity="0"/>
                                    <TextBlock Grid.Column="2" Text="设置" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" CornerRadius="18" Background="#1AFFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1" Padding="12" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="当前版本" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="v1.4 · Neon Center" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentPinkBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <Grid x:Name="ContentPanel" Grid.Column="2" Opacity="0">
                    <ScrollViewer x:Name="OverviewSection" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="StatusCard" Style="{StaticResource HeroCommandCard}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border x:Name="OverviewStatusBadge" Style="{StaticResource StatusBadge}" Margin="0,0,10,0">
                                                <TextBlock x:Name="OverviewStatusText" Text="READY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource StatusReadyBrush}"/>
                                            </Border>
                                            <TextBlock x:Name="StatusTitle" Text="准备启动任务" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="RemainingLabel" Text="默认倒计时" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock x:Name="RemainingTime" Text="00:30:00" FontSize="58" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,6"/>
                                        <TextBlock x:Name="TargetTimeLabel" Text="选择动作和时间后启动任务" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ShutdownModeLabel" Text="执行方式：正常执行" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Width="210" VerticalAlignment="Center">
                                        <Button x:Name="OverviewStartButton" Content="启动倒计时" Style="{StaticResource PrimaryButton}" Click="CountdownStart_Click" Margin="0,0,0,10"/>
                                        <Button x:Name="ExecuteCurrentActionButton" Content="立即执行当前动作" Style="{StaticResource DangerButton}" Click="ExecuteCurrentAction_Click" Margin="0,0,0,10"/>
                                        <Button x:Name="PauseResumeButton" Content="暂停 1 小时" Style="{StaticResource SecondaryButton}" Click="PauseResume_Click" Margin="0,0,0,10" Visibility="Collapsed"/>
                                        <Button x:Name="CancelPlanButton" Content="取消任务计划" Style="{StaticResource SecondaryButton}" Click="CancelShutdown_Click" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="0.95*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CommandCard}">
                                    <StackPanel>
                                        <TextBlock Text="快捷倒计时" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="15 分钟" Tag="15" Style="{StaticResource ChipButton}" Margin="0,0,8,8" Click="QuickCountdown_Click"/>
                                            <Button Content="30 分钟" Tag="30" Style="{StaticResource ChipButton}" Margin="0,0,0,8" Click="QuickCountdown_Click"/>
                                            <Button Content="1 小时" Tag="60" Style="{StaticResource ChipButton}" Margin="0,0,8,0" Click="QuickCountdown_Click"/>
                                            <Button Content="2 小时" Tag="120" Style="{StaticResource ChipButton}" Click="QuickCountdown_Click"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CommandCard}">
                                    <StackPanel>
                                        <TextBlock Text="当前配置" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="OverviewActionSummary" Text="动作：关机" Style="{StaticResource SubtitleText}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="OverviewReminderSummary" Text="提醒：提前 60 秒" Style="{StaticResource SubtitleText}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="OverviewForceSummary" Text="强制关闭：关闭" Style="{StaticResource SubtitleText}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="OverviewScriptSummary" Text="脚本：未启用" Style="{StaticResource SubtitleText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CommandCard}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="电源动作" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="所有定时、触发器和立即执行都会使用这里的动作。" Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
                                    <UniformGrid Columns="3" Rows="2">
                                        <Border x:Name="ActionShutdown" Tag="Shutdown" Style="{StaticResource ActionTile}" Margin="0,0,10,10" MouseLeftButtonDown="PowerAction_Click"><StackPanel><TextBlock Text="关机" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="SHUTDOWN" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                                        <Border x:Name="ActionSleep" Tag="Sleep" Style="{StaticResource ActionTile}" Margin="0,0,10,10" MouseLeftButtonDown="PowerAction_Click"><StackPanel><TextBlock Text="睡眠" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="SLEEP" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                                        <Border x:Name="ActionHibernate" Tag="Hibernate" Style="{StaticResource ActionTile}" Margin="0,0,0,10" MouseLeftButtonDown="PowerAction_Click"><StackPanel><TextBlock Text="休眠" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="HIBERNATE" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                                        <Border x:Name="ActionRestart" Tag="Restart" Style="{StaticResource ActionTile}" Margin="0,0,10,0" MouseLeftButtonDown="PowerAction_Click"><StackPanel><TextBlock Text="重启" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="RESTART" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                                        <Border x:Name="ActionLogOut" Tag="LogOut" Style="{StaticResource ActionTile}" Margin="0,0,10,0" MouseLeftButtonDown="PowerAction_Click"><StackPanel><TextBlock Text="注销" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="LOG OUT" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                                        <Border x:Name="ActionLock" Tag="Lock" Style="{StaticResource ActionTile}" MouseLeftButtonDown="PowerAction_Click"><StackPanel><TextBlock Text="锁定" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="LOCK" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="TimerSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource GlassPanel}" Padding="5" CornerRadius="18" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BtnCountdown" CornerRadius="14" Padding="10,12"
                                            Background="{StaticResource HeroBrush}" MouseLeftButtonDown="CountdownMode_Click" Cursor="Hand"
                                            Effect="{StaticResource NeonShadow}">
                                        <TextBlock Text="倒计时模式" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="BtnFixed" Grid.Column="1" CornerRadius="14" Padding="10,12" Margin="6,0,0,0"
                                            Background="Transparent" MouseLeftButtonDown="FixedMode_Click" Cursor="Hand">
                                        <TextBlock Text="指定时间" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="CountdownPanel" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="CountdownPanelTitle" Text="倒计时关机" Style="{StaticResource TitleText}"/>
                                            <TextBlock x:Name="CountdownPanelSubtitle" Text="输入时长后开始计时，执行前会按设置弹窗提醒。" Style="{StaticResource SubtitleText}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="18" Background="#2279D8FF" BorderBrush="#6679D8FF" BorderThickness="1" Padding="12,8" VerticalAlignment="Center">
                                            <TextBlock Text="COUNTDOWN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource GlassPanel}" Padding="12" CornerRadius="18">
                                            <StackPanel>
                                                <TextBlock Text="小时" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBox x:Name="HoursInput" Text="0" TextAlignment="Center" Width="92" MaxLength="2"
                                                         PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text=":" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>

                                        <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="12" CornerRadius="18">
                                            <StackPanel>
                                                <TextBlock Text="分钟" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBox x:Name="MinutesInput" Text="30" TextAlignment="Center" Width="92" MaxLength="2"
                                                         PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text=":" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>

                                        <Border Grid.Column="4" Style="{StaticResource GlassPanel}" Padding="12" CornerRadius="18">
                                            <StackPanel>
                                                <TextBlock Text="秒" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBox x:Name="SecondsInput" Text="0" TextAlignment="Center" Width="92" MaxLength="2"
                                                         PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Button x:Name="CountdownStartBtn" Content="启动倒计时" Style="{StaticResource PrimaryButton}"
                                            Margin="0,24,0,0" Click="CountdownStart_Click"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="FixedTimePanel" Style="{StaticResource CardBorder}" Margin="0,0,0,16" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="FixedTimePanelTitle" Text="指定时间关机" Style="{StaticResource TitleText}"/>
                                            <TextBlock x:Name="FixedTimePanelSubtitle" Text="选择今天或明天的具体时间，到点自动执行。" Style="{StaticResource SubtitleText}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="18" Background="#22B779FF" BorderBrush="#66B779FF" BorderThickness="1" Padding="12,8" VerticalAlignment="Center">
                                            <TextBlock Text="SCHEDULE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryHoverBrush}"/>
                                        </Border>
                                    </Grid>

                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource GlassPanel}" Padding="14" CornerRadius="18">
                                            <StackPanel>
                                                <TextBlock Text="时" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBox x:Name="FixedHourInput" Text="23" TextAlignment="Center" Width="112" MaxLength="2"
                                                         PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text=":" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>

                                        <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="14" CornerRadius="18">
                                            <StackPanel>
                                                <TextBlock Text="分" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBox x:Name="FixedMinuteInput" Text="00" TextAlignment="Center" Width="112" MaxLength="2"
                                                         PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="重复规则" Style="{StaticResource SubtitleText}" Margin="0,18,0,8"/>
                                    <UniformGrid Columns="4" Margin="0,0,0,4">
                                        <Border x:Name="RepeatOnce" Tag="Once" CornerRadius="14" Padding="10,10" Margin="0,0,8,0"
                                                Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="RepeatRule_Click">
                                            <TextBlock Text="单次" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="RepeatDaily" Tag="Daily" CornerRadius="14" Padding="10,10" Margin="0,0,8,0"
                                                Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="RepeatRule_Click">
                                            <TextBlock Text="每日" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="RepeatWorkdays" Tag="Workdays" CornerRadius="14" Padding="10,10" Margin="0,0,8,0"
                                                Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="RepeatRule_Click">
                                            <TextBlock Text="工作日" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="RepeatWeekends" Tag="Weekends" CornerRadius="14" Padding="10,10"
                                                Background="Transparent" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="RepeatRule_Click">
                                            <TextBlock Text="周末" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </UniformGrid>

                                    <Button x:Name="FixedTimeStartBtn" Content="启动定时" Style="{StaticResource PrimaryButton}"
                                            Margin="0,24,0,0" Click="FixedTimeStart_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="TasksSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="任务中心" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="保存多个常用计划，系统会从启用任务里运行最近的一条。" Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="保存当前为任务" Style="{StaticResource SecondaryButton}" Click="SaveCurrentTask_Click"/>
                                        <Button Grid.Column="2" Content="运行最近启用任务" Style="{StaticResource PrimaryButton}" Click="RunNearestTask_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="TaskListPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="TriggersSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="18">
                                <StackPanel>
                                    <Border Width="38" Height="4" CornerRadius="2" Background="{StaticResource HeroBrush}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <TextBlock Text="网络闲置触发" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="上传和下载速度持续低于阈值后，自动执行当前选择的电源动作。" Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="下载阈值 KB/s" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="NetworkDownloadThresholdInput" Text="100" TextAlignment="Center" PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="上传阈值 KB/s" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="NetworkUploadThresholdInput" Text="50" TextAlignment="Center" PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="持续分钟" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="NetworkIdleMinutesInput" Text="5" TextAlignment="Center" PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="StartNetworkIdleButton" Content="开始监控网络闲置" Style="{StaticResource PrimaryButton}" Click="StartNetworkIdle_Click"/>
                                        <Button Grid.Column="2" x:Name="StopNetworkIdleButton" Content="停止监控" Style="{StaticResource SecondaryButton}" Click="StopNetworkIdle_Click" IsEnabled="False"/>
                                    </Grid>
                                    <TextBlock x:Name="NetworkSpeedLabel" Text="当前速度：等待开始监控" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="NetworkIdleProgressLabel" Text="闲置进度：0/0 秒" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="18">
                                <StackPanel>
                                    <Border Width="38" Height="4" CornerRadius="2" Background="{StaticResource HeroBrush}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <TextBlock Text="进程退出触发" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="监控一个程序，等它全部退出后执行当前电源动作；也可以到点自动关闭它。" Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ProcessListCombo" Height="42" FontSize="14" IsEditable="True" IsTextSearchEnabled="True"/>
                                        <Button Grid.Column="2" x:Name="RefreshProcessListButton" Content="刷新进程" Style="{StaticResource SecondaryButton}" Click="RefreshProcessList_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#44FFFFFF" Margin="0,16,0,16"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="自动关闭被监控程序" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="开启后，到设定时间会先关闭该程序；程序退出后再触发当前电源动作。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border x:Name="ProcessAutoCloseToggle" Grid.Column="1" Width="56" Height="30" CornerRadius="15" Cursor="Hand"
                                                MouseLeftButtonDown="ProcessAutoCloseToggle_Click" BorderBrush="#5536E8FF" BorderThickness="1">
                                            <Border x:Name="ProcessAutoCloseKnob" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                        </Border>
                                    </Grid>

                                    <Grid x:Name="ProcessAutoCloseSettingsPanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="小时" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="ProcessCloseHoursInput" Text="1" TextAlignment="Center" MaxLength="2"
                                                     PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="分钟" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="ProcessCloseMinutesInput" Text="0" TextAlignment="Center" MaxLength="2"
                                                     PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="秒" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="ProcessCloseSecondsInput" Text="0" TextAlignment="Center" MaxLength="2"
                                                     PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="关闭超时秒" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="ProcessCloseTimeoutInput" Text="10" TextAlignment="Center" MaxLength="3"
                                                     PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock x:Name="ProcessAutoCloseStatusLabel" Text="自动关闭：未启用" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="StartProcessTriggerButton" Content="开始监控进程退出" Style="{StaticResource PrimaryButton}" Click="StartProcessTrigger_Click"/>
                                        <Button Grid.Column="2" x:Name="StopProcessTriggerButton" Content="停止监控" Style="{StaticResource SecondaryButton}" Click="StopProcessTrigger_Click" IsEnabled="False"/>
                                    </Grid>
                                    <TextBlock x:Name="ProcessTriggerStatusLabel" Text="进程状态：等待选择" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ScriptSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="执行前脚本" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                                    <TextBlock Text="执行电源动作前先运行 bat/cmd/ps1 脚本；失败或超时会自动取消动作。" Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PreActionScriptPathInput" Text="" FontSize="13"/>
                                        <Button Grid.Column="2" Content="选择脚本" Style="{StaticResource SecondaryButton}" Click="BrowsePreActionScript_Click"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PreActionScriptToggleButton" Content="启用脚本" Style="{StaticResource SecondaryButton}" Click="TogglePreActionScript_Click"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="超时秒数" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>
                                            <TextBox x:Name="PreActionScriptTimeoutInput" Text="60" TextAlignment="Center" PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus" LostFocus="PreActionScriptTimeoutInput_LostFocus"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="PreActionScriptStatusLabel" Text="脚本状态：未启用" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="SettingsSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="偏好设置" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="ReminderSettingTitle" Text="提醒提前时间" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="ReminderSettingSubtitle" Text="关机前弹窗提醒，可在 10-300 秒之间设置。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="ReminderMinus" Content="-" Width="36" Height="36" Style="{StaticResource SecondaryButton}" Padding="0" Click="ReminderMinus_Click"/>
                                            <TextBox x:Name="ReminderSecondsInput" Text="60" TextAlignment="Center" Width="62" Margin="6,0" MaxLength="4" Padding="4,8"
                                                     PreviewTextInput="NumberPreviewTextInput" GotKeyboardFocus="NumberInput_GotKeyboardFocus" LostFocus="ReminderSecondsInput_LostFocus"/>
                                            <Button x:Name="ReminderPlus" Content="+" Width="36" Height="36" Style="{StaticResource SecondaryButton}" Padding="0" Click="ReminderPlus_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#44FFFFFF" Margin="0,0,0,16"/>

                                    <Grid x:Name="ForceCloseRow" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="强制关闭应用" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="ForceCloseHint" Text="开启后会关闭所有应用，未保存内容可能丢失。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border x:Name="ForceCloseToggle" Grid.Column="1" Width="56" Height="30" CornerRadius="15" Cursor="Hand"
                                                MouseLeftButtonDown="ForceCloseToggle_Click" BorderBrush="#5536E8FF" BorderThickness="1">
                                            <Border x:Name="ForceCloseKnob" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                        </Border>
                                    </Grid>

                                    <Border Height="1" Background="#44FFFFFF" Margin="0,0,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="开机自动启动" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="电脑开机时自动在托盘运行。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Border x:Name="AutoStartToggle" Grid.Column="1" Width="56" Height="30" CornerRadius="15" Cursor="Hand"
                                                MouseLeftButtonDown="AutoStartToggle_Click" BorderBrush="#5536E8FF" BorderThickness="1">
                                            <Border x:Name="AutoStartKnob" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
