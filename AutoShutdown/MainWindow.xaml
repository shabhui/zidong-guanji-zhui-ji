<Window x:Class="AutoShutdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="640"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Height="44" Background="#16162A" CornerRadius="16,16,0,0">
            <Grid>
                <TextBlock Text="智能定时关机" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                            Width="36" Height="36" FontSize="12"
                            Background="Transparent" Foreground="#A0A0B8"
                            Click="Minimize_Click" Padding="0"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Width="36" Height="36" FontSize="12"
                            Background="Transparent" Foreground="#EF4444"
                            Click="Close_Click" Padding="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,20,32,32">

                <!-- Mode Tabs -->
                <Border Style="{StaticResource CardBorder}" Padding="4" CornerRadius="12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BtnCountdown" CornerRadius="10" Padding="8,10"
                                Background="{StaticResource PrimaryBrush}" MouseLeftButtonDown="CountdownMode_Click" Cursor="Hand">
                            <TextBlock Text="⏱ 倒计时" FontWeight="SemiBold" FontSize="14"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <Border x:Name="BtnFixed" Grid.Column="1" CornerRadius="10" Padding="8,10"
                                Background="Transparent" MouseLeftButtonDown="FixedMode_Click" Cursor="Hand">
                            <TextBlock Text="🕐 指定时间" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Countdown Panel -->
                <Border x:Name="CountdownPanel" Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="设置倒计时" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                        <TextBlock Text="设定一段时长，到时间后自动关机" Style="{StaticResource SubtitleText}" Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Hours -->
                            <StackPanel>
                                <TextBlock Text="小时" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                <TextBox x:Name="HoursInput" Text="0" TextAlignment="Center"
                                         Width="80" HorizontalAlignment="Center" MaxLength="2"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                            </StackPanel>

                            <TextBlock Text=":" FontSize="28" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="8,10,8,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <!-- Minutes -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="分钟" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                <TextBox x:Name="MinutesInput" Text="30" TextAlignment="Center"
                                         Width="80" HorizontalAlignment="Center" MaxLength="2"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text=":" FontSize="28" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="8,10,8,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <!-- Seconds -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="秒" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                <TextBox x:Name="SecondsInput" Text="0" TextAlignment="Center"
                                         Width="80" HorizontalAlignment="Center" MaxLength="2"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="CountdownStartBtn" Content="▶ 开始倒计时"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,24,0,0" Click="CountdownStart_Click"/>
                    </StackPanel>
                </Border>

                <!-- Fixed Time Panel -->
                <Border x:Name="FixedTimePanel" Style="{StaticResource CardBorder}" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="指定关机时间" Style="{StaticResource TitleText}" Margin="0,0,0,8"/>
                        <TextBlock Text="设定一个具体的时间点，每天届时自动关机" Style="{StaticResource SubtitleText}" Margin="0,0,0,20"/>

                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="时" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                <TextBox x:Name="FixedHourInput" Text="23" TextAlignment="Center"
                                         Width="100" HorizontalAlignment="Center" MaxLength="2"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text=":" FontSize="28" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="16,10,16,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="分" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                <TextBox x:Name="FixedMinuteInput" Text="00" TextAlignment="Center"
                                         Width="100" HorizontalAlignment="Center" MaxLength="2"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="FixedTimeStartBtn" Content="▶ 开始定时"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,24,0,0" Click="FixedTimeStart_Click"/>
                    </StackPanel>
                </Border>

                <!-- Status Card -->
                <Border x:Name="StatusCard" Style="{StaticResource CardBorder}" Margin="0,0,0,20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="关机计划运行中" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimaryBrush}">
                                <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RemainingLabel" Text="剩余时间" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="RemainingTime" Text="00:30:00" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TargetTimeLabel" Margin="0,12,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>

                        <Button Content="✕ 取消关机" Style="{StaticResource DangerButton}"
                                Margin="0,16,0,0" Click="CancelShutdown_Click"/>
                    </StackPanel>
                </Border>

                <!-- Settings Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="设置" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

                        <!-- Reminder seconds -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="提醒提前时间" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="关机前弹窗提醒" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ReminderMinus" Content="-" Width="36" Height="36"
                                        Style="{StaticResource SecondaryButton}" Padding="0"
                                        Click="ReminderMinus_Click"/>
                                <TextBox x:Name="ReminderSecondsInput" Text="60" TextAlignment="Center"
                                         Width="56" Margin="6,0" MaxLength="4" Padding="4,8"
                                         PreviewTextInput="NumberPreviewTextInput"/>
                                <Button x:Name="ReminderPlus" Content="+" Width="36" Height="36"
                                        Style="{StaticResource SecondaryButton}" Padding="0"
                                        Click="ReminderPlus_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Auto start toggle -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开机自动启动" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="电脑开机时自动运行" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Border x:Name="AutoStartToggle" Grid.Column="1" Width="52" Height="28"
                                    CornerRadius="14" Cursor="Hand" MouseLeftButtonDown="AutoStartToggle_Click">
                                <Border x:Name="AutoStartKnob" Width="22" Height="22" CornerRadius="11"
                                        HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
