<Window x:Class="AutoShutdown.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" Height="370"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ReminderRoot" ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080A17" Offset="0"/>
                <GradientStop Color="#111634" Offset="0.45"/>
                <GradientStop Color="#27164F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse x:Name="AlertGlow" Width="260" Height="260" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-150,0,0" Fill="#FB3B6D" Opacity="0.30" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="72"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="180" Height="180" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-88,-72" Fill="#22D3EE" Opacity="0.18" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="58"/>
            </Ellipse.Effect>
        </Ellipse>

        <Border x:Name="ReminderCard" Style="{StaticResource CardBorder}" Margin="26" Padding="30"
                BorderBrush="#AAFB3B6D" Effect="{StaticResource DangerShadow}">
            <StackPanel VerticalAlignment="Center">
                <Border Width="68" Height="68" CornerRadius="24" Background="{StaticResource DangerBrush}"
                        Effect="{StaticResource DangerShadow}" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TitleLabel" Text="即将关机" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="WarningLabel" Text="POWER ACTION WARNING" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10"/>

                <TextBlock x:Name="MessageLabel" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <Border HorizontalAlignment="Center" CornerRadius="24" Background="#7011182B" BorderBrush="#66FBBF24" BorderThickness="1"
                        Padding="22,8" Margin="0,4,0,8">
                    <TextBlock x:Name="CountdownLabel" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource WarningBrush}"/>
                </Border>

                <TextBlock Text="请保存正在编辑的内容，或选择延迟/取消。" FontSize="12" HorizontalAlignment="Center"
                           TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,22"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" FontSize="13" Padding="8,10"/>
                    <Button Grid.Column="2" Content="延迟 5 分钟" Style="{StaticResource SecondaryButton}" Click="Delay_Click" FontSize="13" Padding="8,10"/>
                    <Button Grid.Column="4" x:Name="ExecuteNowButton" Content="立即关机" Style="{StaticResource DangerButton}" Click="ShutdownNow_Click" FontSize="13" Padding="8,10"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
