<Window x:Class="AutoShutdown.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" Height="320"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Border Background="{StaticResource BgCardBrush}" CornerRadius="20">
            <StackPanel VerticalAlignment="Center" Margin="32">
                <!-- Icon -->
                <Border Width="56" Height="56" CornerRadius="28"
                        Background="{StaticResource WarningBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="⚠" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="即将关机" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                <TextBlock x:Name="MessageLabel" FontSize="14"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="CountdownLabel" FontSize="36" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource WarningBrush}" Margin="0,8,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click" FontSize="13" Padding="8,10"/>

                    <Button Grid.Column="2" Content="延迟5分钟"
                            Style="{StaticResource SecondaryButton}"
                            Click="Delay_Click" FontSize="13" Padding="8,10"/>

                    <Button Grid.Column="4" Content="立即关机"
                            Style="{StaticResource DangerButton}"
                            Click="ShutdownNow_Click" FontSize="13" Padding="8,10"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
